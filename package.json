{
  "name": "blog-editor",
  "version": "1.0.0",
  "private": true,
  "description": "Visual markdown editor for 11ty blog with GitHub PR integration",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:server": "bun run --filter @blog-editor/server dev",
    "dev:web": "bun run --filter @blog-editor/web dev",
    "dev:blog": "npm --prefix blog run dev",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "lint": "bun run --filter '*' lint",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "license": "ISC",
  "devDependencies": {
    "bun-types": "^1.3.14",
    "jsdom": "^30.0.1"
  }
}
